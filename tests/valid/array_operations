int main() {
    int a[5] = {5, 4, 3, 2, 1};
    int n = 5;
    for (int i = 0; i < n - 1; i = i + 1) {
        for (int j = 0; j < n - 1 - i; j = j + 1) {
            if (a[j] > a[j + 1]) {
                int tmp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = tmp;
            }
        }
    }
    a[a[0] - 1] = a[(1 + 2) * 1];
    return 0;
}
